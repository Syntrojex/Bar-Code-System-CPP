{
    "version": 2,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "default",
            "displayName": "BarcodeHub - Visual Studio",
            "description": "Configure BarcodeHub using Visual Studio and vcpkg",
            "generator": "Visual Studio 18 2026",
            "binaryDir": "${sourceDir}/build",
            "architecture": "x64",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_TARGET_TRIPLET": "x64-windows"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "release",
            "displayName": "Build BarcodeHub - Release",
            "configurePreset": "default",
            "configuration": "Release"
        },
        {
            "name": "debug",
            "displayName": "Build BarcodeHub - Debug",
            "configurePreset": "default",
            "configuration": "Debug"
        }
    ]
}
